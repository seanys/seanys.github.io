{% assign profile = site.data.repositories.github_user_details[include.username] %}

<div class="repo repo-summary p-2">
  <div class="repo-card repo-summary-card" aria-label="GitHub summary for {{ include.username }}">
    <span><strong>{{ profile.public_repos }}</strong> Public repositories</span>
    <span><strong>{{ profile.total_stars }}</strong> Stars earned</span>
    <span><strong>{{ profile.total_forks }}</strong> Forks</span>
    <span><strong>{{ profile.followers }}</strong> Followers</span>
  </div>
</div>
